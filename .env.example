# ─────────────────────────────────────────────────────────────
#  CRM Raone — variáveis de ambiente
#  Copie para .env.local (dev) e configure no painel da Vercel (prod).
#  NUNCA commitar .env com valores reais.
# ─────────────────────────────────────────────────────────────

# --- Banco de dados (Neon / Supabase / Postgres) ---
# Conexão com pool (pgbouncer) — usada pela aplicação em runtime serverless.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require&pgbouncer=true"
# Conexão direta — usada só pelas migrações do Prisma.
DIRECT_URL="postgresql://user:password@host/db?sslmode=require"

# --- Autenticação (Auth.js v5) ---
# Gere com: openssl rand -base64 32
AUTH_SECRET="troque-por-um-segredo-aleatorio"
# Em produção a Vercel injeta a URL automaticamente; em dev:
AUTH_URL="http://localhost:3000"

# --- IA (Fase 4) — provedor trocável ---
# Sem chave: o CRM usa a heurística determinística (funciona, sem custo).
AI_PROVIDER="anthropic"          # anthropic | openai
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
AI_MODEL="claude-haiku-4-5"      # rápido e barato para classificação em volume
# US$ por 1M tokens do modelo escolhido (só para estimar o custo na tela).
AI_COST_INPUT_PER_MTOK="1"
AI_COST_OUTPUT_PER_MTOK="5"

# --- Fila de webhooks (Fase 3) — opcional ---
# Sem QStash, o cron da Vercel drena a fila a cada minuto.
QSTASH_TOKEN=""
QSTASH_CURRENT_SIGNING_KEY=""
QSTASH_NEXT_SIGNING_KEY=""

# --- Meta / canais (Fase 3) ---
# App Secret e verify token são GLOBAIS do app da Meta (ficam aqui).
# Os ids de número/página e o access token de cada canal são cadastrados na
# tela Integrações (admin) e guardados CIFRADOS no banco — não vão no .env.
META_APP_ID=""
META_APP_SECRET=""
# Token usado no handshake de verificação dos webhooks (você escolhe o valor).
META_WEBHOOK_VERIFY_TOKEN="defina-um-token-de-verificacao"
# Versão da Graph API (confira a atual na doc da Meta).
META_GRAPH_VERSION="v22.0"

# --- Chave para cifrar tokens de canal em repouso (AES-256-GCM) ---
# 32 bytes em base64. Gere com: openssl rand -base64 32
CHANNEL_TOKEN_ENCRYPTION_KEY=""

# --- Armazenamento de mídia (Fase 2/3) ---
BLOB_READ_WRITE_TOKEN=""

# --- Proteção dos endpoints de cron ---
CRON_SECRET="defina-um-segredo-para-o-cron"
